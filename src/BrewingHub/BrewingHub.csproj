<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>BrewingHub</AssemblyName>
    <RootNamespace>BrewingHub</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">D:\Games\Survival Log\Survival Log</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <Interop>$(GameDir)\BepInEx\interop</Interop>
    <ToolkitDll Condition="'$(ToolkitDll)' == ''">D:\devnew\game-mods\SurvivalLog\mods\sl-exiled-toolkit\src\ExiledToolkit\bin\Release\ExiledToolkit.dll</ToolkitDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(Interop)\HotUpdate.dll" Private="false" />
    <Reference Include="$(Interop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Interop)\Vuplex.WebView.dll" Private="false" />
    <Reference Include="$(Interop)\R3.dll" Private="false" />
    <Reference Include="$(Interop)\ObservableCollections.dll" Private="false" />
    <Reference Include="$(ToolkitDll)" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="page.js" LogicalName="BrewingHub.page.js" />
  </ItemGroup>

  <!-- What the Mod Manager's Mods screen shows about this mod. -->
  <ItemGroup>
    <AssemblyMetadata Include="ModManager.Name" Value="Brewing Hub&#10;酿酒中心" />
    <AssemblyMetadata Include="ModManager.Description" Value="A better brewing barrel screen. See the drink, quality, bottles and brewing time as you fill the barrel, with one-click changes that make a better drink or one more bottle. Brew now fills the barrel for Poor, Average or Strong from your bag and home storage, food closest to spoiling first. Recipes, Ingredients and Barrels tabs show what each food gives, what each drink is for, and every barrel in your base. Collect and brew again in one click, or set a barrel to brew again when collected.&#10;更好的酿酒桶界面。装桶时直接显示酿出的酒、品质、瓶数和酿造时间，并提供一键调整，酿出更好的酒或多一瓶。「现在能酿」用背包和家中储物为劣质、普通或烈性装桶，最快变质的食材优先。「酒谱」「食材」「酿酒桶」标签页显示每种食材的数值、每种酒的用途，以及基地里的每个酿酒桶。一键取出并再酿一桶，或设置酿酒桶取出后自动再酿。" />
    <AssemblyMetadata Include="ModManager.Author" Value="AnExiledDev" />
    <AssemblyMetadata Include="ModManager.Category" Value="QualityOfLife" />
    <AssemblyMetadata Include="ModManager.GameVersion" Value="1.1.19611" />
    <AssemblyMetadata Include="ModManager.Settings" Value="Restart" />
    <AssemblyMetadata Include="ModManager.GitHub" Value="AnExiledDev/SurvivalLog-BrewingHub" />
    <AssemblyMetadata Include="ModManager.Changelog" Value="https://github.com/AnExiledDev/SurvivalLog-BrewingHub/blob/main/CHANGELOG.md" />
  </ItemGroup>

</Project>
